# Gaurav Marbles - Environment Configuration Example
# Copy this file to .env.local for local development.
# In Vercel, add these keys under Project Settings -> Environment Variables.

# Public Site Canonical URL
NEXT_PUBLIC_SITE_URL=https://gauravmarbles.com

# Firebase Client Configuration (Required for Admin ERP & Authentication)
# Obtain these values from: Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
